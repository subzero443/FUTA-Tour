{
  "name": "futa-tour-pwa",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
